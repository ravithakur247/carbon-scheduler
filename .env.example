# Redis connection
REDIS_URL=redis://localhost:6379/0

# Carbon data source: "mock" (no key needed, simulated day/night curve) or "electricitymaps"
CARBON_PROVIDER=mock
ELECTRICITYMAPS_API_KEY=
ELECTRICITYMAPS_ZONE=US-MIDA-PJM

# Scheduler behavior
CLEAN_THRESHOLD_G_PER_KWH=250
POLL_INTERVAL_SECONDS=15
MAX_WAIT_MINUTES=60

# Simulated inference energy cost
ENERGY_PER_1K_TOKENS_KWH=0.0024

# Comma-separated regions for multi-region routing (first one is treated as "home")
REGIONS=US-MIDA-PJM,US-CAL-CISO,EU-FR
